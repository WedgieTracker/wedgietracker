{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules/**"],
  "rules": {
    "no-array-constructor": "error",
    "no-duplicate-imports": "error",
    "no-unused-vars": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error"
  }
}
