<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="relative h--[40cqh] lg:h--[34cqh] w--full rounded--base outline">
    <img class="absolute inset--0 w--full h--full rounded--base image-dither" src="data:image/svg+xml;base64,{{ wave_svg | base64_encode }}">
    <div class="relative z--2 flex flex--col flex--center-x flex--center-y h--full w--full px--2 pt--1 lg:pt--2 pb--2 lg:pb--8">
      <span class="label label--small label--filled">{{ record_label }}</span>
      <span class="value lg:value--xxxlarge value--tnums text--bold" data-fit-value="true">{{ total }}</span>
      <span class="title lg:title--large text--bold">WEDGIES</span>
      {% if live %}<span class="label label--small label--filled">Games live now</span>{% endif %}
    </div>
  </div>
  <div class="flex flex--col flex--left gap--small">
    <span class="title title--small hidden lg:visible">Latest wedgies</span>
    {% for w in latest limit: 3 %}
    <div class="flex flex--row flex--center-y gap--small lg:gap{% if forloop.index == 3 %} hidden lg:flex portrait:flex{% endif %}">
      <div class="flex flex--col flex--center-x gap--none w--24 lg:w--20 portrait:w--20 py--1 lg:py--2 no-shrink bg--black rounded--small"><span class="title lg:title--large text--bold text--white"><span class="label label--xsmall lg:label--small text--white">#</span>{{ w.number }}</span><span class="label label--xsmall lg:label--small text--white">{{ w.date }}</span></div>
      <div class="flex flex--col flex--left gap--none">
        <span class="title title--small lg:title--base" data-clamp="1">{{ w.player }}</span>
        <span class="label label--small lg:label--base" data-clamp="1">{{ w.team }}{% if w.against != "" %} - {{ w.against }}{% endif %}</span>
        <span class="label label--small label--gray hidden lg:visible">{{ w.type }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-2">
    <div class="flex flex--col flex--left gap--none">
      {% if show_pace %}<span class="value lg:value--xlarge value--tnums text--bold">{{ pace }}</span><span class="title lg:title--xlarge text--bold">PACE</span>{% else %}<span class="value lg:value--xlarge value--tnums text--bold">{{ record }}</span><span class="title text--bold">RECORD TO BEAT</span>{% endif %}
    </div>
    <div class="flex flex--col flex--left gap--none">
      <span class="value lg:value--xlarge value--tnums text--bold">{{ days_since | default: "-" }}</span>
      <span class="title title--small text--bold">DAYS WITHOUT WEDGIES</span>
    </div>
  </div>
</div>

<div class="title_bar flex flex--row flex--center-x">
  <img class="image image--adaptive hidden lg:block" src="data:image/svg+xml;base64,{{ wt_logo | base64_encode }}" alt="WedgieTracker">
  <img class="image lg:hidden dark:hidden" src="data:image/svg+xml;base64,{{ wt_logo | base64_encode }}" alt="WedgieTracker">
  <img class="image hidden dark:block dark:lg:hidden" src="data:image/svg+xml;base64,{{ wt_logo | replace: '#000', '#fff' | replace: '<svg ', '<svg fill="#fff" ' | base64_encode }}" alt="WedgieTracker">
</div>
