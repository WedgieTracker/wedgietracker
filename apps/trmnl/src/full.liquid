<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="grid gap--large h--[60cqh] portrait:grid--cols-1 portrait:h--auto">
    <div class="col--span-5 portrait:col--span-1 relative h--full portrait:h--[34cqh] rounded--base outline">
      <img class="absolute inset--0 w--full h--full rounded--base image-dither" src="data:image/svg+xml;base64,{{ wave_svg | base64_encode }}">
      <div class="relative z--2 flex flex--col flex--center-x flex--center-y h--full w--full px--4 pt--4 pb--12">
        <span class="label label--small label--filled">{{ record_label }}</span>
        <span class="value value--xxxlarge lg:value--mega value--tnums text--bold" data-fit-value="true">{{ total }}</span>
        <span class="value value--small text--bold">WEDGIES</span>
        {% if live %}<span class="label label--small label--filled mt--1">Games live now</span>{% endif %}
      </div>
    </div>
    <div class="col--span-7 portrait:col--span-1 flex flex--col flex--left flex--center-y gap--small lg:gap--large">
      <span class="title title--small lg:title--base">Latest wedgies</span>
      {% for w in latest limit: 3 %}
      <div class="flex flex--row flex--center-y gap lg:gap--large">
        <div class="flex flex--col flex--center-x gap--none w--20 lg:w--32 py--1 lg:py--3 no-shrink bg--black rounded--small"><span class="title title--large lg:title--xxlarge text--bold text--white"><span class="label label--small lg:label--large text--white">#</span>{{ w.number }}</span><span class="label label--small lg:label--large text--white">{{ w.date }}</span></div>
        <div class="flex flex--col flex--left gap--none grow">
          <span class="title lg:title--xlarge lg:portrait:title--large" data-clamp="1">{{ w.player }}</span>
          <span class="label lg:label--large" data-clamp="1">{{ w.team }}{% if w.against != "" %} - {{ w.against }}{% endif %}</span>
          <span class="label label--small lg:label--base 4bit:label--gray">{{ w.type }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-3 portrait:grid--cols-1 lg:portrait:grid--cols-3">
    <div class="flex flex--col portrait:flex--row lg:portrait:flex--col">
      <span class="value value--small lg:value--large value--tnums text--bold">{{ days_since | default: "-" }}</span>
      <span class="title title--small lg:title--base lg:portrait:title--small">DAYS WITHOUT WEDGIES</span>
    </div>
    <div class="flex flex--col portrait:flex--row lg:portrait:flex--col">
      {% if show_pace %}<span class="value value--small lg:value--large value--tnums text--bold">{{ pace }}</span><span class="title title--small lg:title--base lg:portrait:title--small">PACE</span>{% else %}<span class="value value--small lg:value--large value--tnums text--bold">{{ record }}</span><span class="title title--small lg:title--base lg:portrait:title--small">RECORD TO BEAT</span>{% endif %}
    </div>
    <div class="flex flex--col portrait:flex--row lg:portrait:flex--col">
      <span class="value value--small lg:value--large value--tnums text--bold">{{ all_time }}</span>
      <span class="title title--small lg:title--base lg:portrait:title--small">TOTAL WEDGIES FROM 14/15</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image--adaptive hidden lg:block" src="data:image/svg+xml;base64,{{ wt_logo | base64_encode }}" alt="WedgieTracker">
  <img class="image lg:hidden dark:hidden" src="data:image/svg+xml;base64,{{ wt_logo | base64_encode }}" alt="WedgieTracker">
  <img class="image hidden dark:block dark:lg:hidden" src="data:image/svg+xml;base64,{{ wt_logo | replace: '#000', '#fff' | replace: '<svg ', '<svg fill="#fff" ' | base64_encode }}" alt="WedgieTracker">
  <span class="instance">wedgietracker.com</span>
</div>
