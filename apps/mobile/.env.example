# Copy to .env.local and fill in. All three are client keys, safe to ship.
# Sentry project wedgietracker-ios, org zokegg-ltd, EU region.
EXPO_PUBLIC_SENTRY_DSN=
# PostHog "Default project" on EU cloud, shared with another app and
# separated by the `app` property every event carries. See lib/observability.ts.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
