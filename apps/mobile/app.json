{
  "expo": {
    "name": "WedgieTracker",
    "slug": "wedgietracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wedgietracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wedgietracker.app",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wedgietracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#12002E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12002E",
          "imageWidth": 320
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "zokegg-ltd",
          "project": "wedgietracker-ios"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://www.wedgietracker.com",
      "router": {},
      "eas": {
        "projectId": "23d9d8e5-8a35-40b2-9a36-d15775b1952d"
      }
    },
    "owner": "gek0z"
  }
}
