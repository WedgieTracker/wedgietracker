{
  "$schema": "https://docs.fallow.tools/schema/fallow-config.json",
  "ignoreExports": [
    {
      "file": "src/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "src/trpc/react.tsx",
      "exports": ["RouterInputs", "RouterOutputs"]
    }
  ],
  "duplicates": {
    "minLines": 30
  },
  "health": {
    "maxCyclomatic": 45,
    "maxCognitive": 25,
    "maxCrap": 2000
  }
}
