{
  "name": "@wedgietracker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "oxlint && tsc --noEmit && vitest run",
    "db:dump": "node --env-file=.env scripts/dump-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo --experimental-https",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,mdx,yml,yaml,css}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,mdx,yml,yaml,css}\" --cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:build": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@libsql/client": "^0.18.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@next/third-parties": "^16.3.4",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@wedgietracker/core": "workspace:*",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^174.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.42",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/archiver": "^8.0.0",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "canvas": "^3.2.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oauth-1.0a": "^2.2.6",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./api": "./dist-types/server/api/types.d.ts"
  }
